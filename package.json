{
  "name": "umriss",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:pages": "node scripts/build-pages.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint --max-warnings 0 packages/charts packages/core packages/table packages/schedule packages/calculation packages/demo",
    "dev:core": "pnpm --filter @umriss-ui/core dev",
    "dev:charts": "pnpm --filter @umriss-ui/charts dev",
    "dev:table": "pnpm --filter @umriss-ui/table dev",
    "dev:schedule": "pnpm --filter @umriss-ui/schedule dev",
    "dev:calculation": "pnpm --filter @umriss-ui/calculation dev",
    "test:unit": "pnpm -r test:unit",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "postcss": "8.5.26",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.14.4+sha512.c8180b3fbe4e4bca02c94234717896b5529740a6cbadf19fa78254270403ea2f27d4e1d46a08a0f56c89b63dc8ebfd3ee53326da720273794e6200fcf0d184ab"
}
