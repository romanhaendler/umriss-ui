{
  "name": "umriss",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:site": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/build-site.mjs",
    "start": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/start.mjs",
    "previews": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/previews.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "check": "node scripts/check.mjs",
    "changelog": "node scripts/changelog.mjs",
    "check:site": "pnpm -r --if-present check:site",
    "typecheck": "pnpm -r typecheck && pnpm -r --if-present typecheck:demo",
    "lint": "eslint --max-warnings 0 packages/charts packages/core packages/table packages/schedule packages/calculation packages/dashboard packages/alarms packages/demo",
    "dev:core": "pnpm --filter @umriss-ui/core dev",
    "dev:charts": "pnpm --filter @umriss-ui/charts dev",
    "dev:table": "pnpm --filter @umriss-ui/table dev",
    "dev:schedule": "pnpm --filter @umriss-ui/schedule dev",
    "dev:calculation": "pnpm --filter @umriss-ui/calculation dev",
    "dev:dashboard": "pnpm --filter @umriss-ui/dashboard dev",
    "dev:alarms": "pnpm --filter @umriss-ui/alarms dev",
    "test:unit": "pnpm -r test:unit",
    "test:visual": "playwright test",
    "test:visual:quick": "node scripts/visual-quick.mjs",
    "test:visual:on-main": "bash scripts/visual-on-main.sh",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "babel-jest": "^30",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30",
    "jest-environment-jsdom": "^30",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.33.0",
    "postcss": "8.5.26",
    "react-server-dom-webpack": "19.2.8",
    "typescript-floor": "npm:typescript@~5.4.5",
    "typescript-eslint": "^8.19.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@9.14.4+sha512.c8180b3fbe4e4bca02c94234717896b5529740a6cbadf19fa78254270403ea2f27d4e1d46a08a0f56c89b63dc8ebfd3ee53326da720273794e6200fcf0d184ab"
}
