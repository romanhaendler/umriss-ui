{
  "name": "@umriss-ui/charts",
  "version": "0.41.1",
  "description": "React canvas chart library for data-dense dashboards - line, area, bar, box plot, scatter, control and Pareto charts. Few chart kinds, drawn well, fast.",
  "license": "MIT",
  "author": "Roman Händler",
  "homepage": "https://github.com/romanhaendler/umriss-ui/tree/main/packages/charts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romanhaendler/umriss-ui.git",
    "directory": "packages/charts"
  },
  "bugs": {
    "url": "https://github.com/romanhaendler/umriss-ui/issues"
  },
  "keywords": [
    "react",
    "react-charts",
    "charts",
    "chart-library",
    "canvas",
    "line-chart",
    "bar-chart",
    "box-plot",
    "scatter-plot",
    "control-chart",
    "pareto",
    "dashboard",
    "typescript",
    "umriss"
  ],
  "type": "module",
  "files": [
    "dist",
    "docs/llms-full.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/charts.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "wording/de": ["dist/de.d.ts"],
      "styles.css": ["dist/styles.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/charts.js",
      "default": "./dist/charts.js"
    },
    "./wording/de": {
      "types": "./dist/de.d.ts",
      "import": "./dist/wording/de.js",
      "default": "./dist/wording/de.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/charts.css"
    }
  },
  "scripts": {
    "props": "node --disable-warning=ExperimentalWarning --experimental-strip-types demo/props.ts",
    "prepack": "pnpm run props",
    "predev": "pnpm run props",
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build",
    "prebuild:demo": "pnpm run props",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:demo": "pnpm run props && tsc --noEmit -p tsconfig.demo.json",
    "check:site": "pnpm run props -- --check",
    "preview:demo": "vite preview --config vite.demo.config.ts --port 4174 --strictPort",
    "test:unit": "vitest run",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm run check:dist",
    "check:dist": "node --disable-warning=ExperimentalWarning --experimental-strip-types ../../scripts/check-dist.ts charts.js charts.css"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@umriss-ui/demo": "workspace:*",
    "@umriss-ui/core": "workspace:*",
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0"
  }
}
